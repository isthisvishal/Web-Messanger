# Web Messenger — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/web_messenger"

# Redis (local or Upstash)
REDIS_URL="redis://localhost:6379"
# Redis token for local @upstash/redis dev mode
REDIS_TOKEN="local_dev_token"
# For Upstash (recommended for production):
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Web Messenger"
NODE_ENV="development"

# Session encryption (generate: openssl rand -base64 32)
SESSION_SECRET="change-me-32-bytes-minimum-random-string"

# Server-side encryption for sensitive DB fields (generate: openssl rand -base64 32)
SERVER_ENCRYPTION_KEY="change-me-32-bytes-minimum-random-string"

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME="Web Messenger"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# Set to 'true' if deployed behind Cloudflare (enables CF-Connecting-IP header trust)
BEHIND_CLOUDFLARE=false

# Comma-separated trusted proxy IPs (your load balancer / reverse proxy IPs)
TRUSTED_PROXY_IPS=
